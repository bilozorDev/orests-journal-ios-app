# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/orests_journal?sslmode=require

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://xxx.clerk.accounts.dev

# Storage (Cloudflare R2 or S3)
S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
S3_BUCKET_NAME=orests-journal
S3_PUBLIC_URL=https://pub-xxx.r2.dev

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-xxx

# App settings
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,orests-journal://
